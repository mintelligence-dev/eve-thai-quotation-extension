{
  "name": "eve-thai-quotation-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Workspace for @eve-thai-quotation-extension/core and @eve-thai-quotation-extension/eve.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm run build -w @eve-thai-quotation-extension/core",
    "build:eve": "npm run build:core && npm run build -w @eve-thai-quotation-extension/eve",
    "build": "npm run build:eve",
    "test": "npm run build:core && vitest run",
    "typecheck": "npm run build:core && tsc --noEmit && npm run typecheck -w @eve-thai-quotation-extension/eve",
    "lint": "eslint",
    "try-samples": "npm run build:core && tsx scripts/try-samples.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24.19.2",
    "ai": "^7.0.148",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
