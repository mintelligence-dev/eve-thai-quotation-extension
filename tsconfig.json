{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "scripts/**/*.ts",
    "packages/core/src/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "packages/*/dist"
  ]
}
