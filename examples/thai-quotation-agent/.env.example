# Copy to .env.local for local work. On Vercel, set these as Production environment variables.

# Model access for "AI" mode. A capped AI Gateway key is recommended.
AI_GATEWAY_API_KEY=

# The password for the /catalog page. Without it the page is open in development and locked in production.
QUOTATION_ADMIN_PASSWORD=

# Telegram (optional). Token from @BotFather; the secret is any long random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Comma-separated Telegram user ids allowed to change the shop catalog. Send /myid to the bot to see yours.
QUOTATION_ADMIN_TELEGRAM_IDS=

# Only with a custom domain: the address draft links are built from.
QUOTATION_WEB_URL=

# Added by `vercel blob create-store`. Leave empty locally to keep drafts in .data/.
BLOB_READ_WRITE_TOKEN=
