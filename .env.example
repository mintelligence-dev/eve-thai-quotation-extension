# Optional. Without a key the app runs in offline mode (rule-based matching, no AI).
# Create one at https://vercel.com/dashboard → AI Gateway → API Keys.
# On Vercel you can omit it: the Gateway authenticates with the deployment's OIDC token.
AI_GATEWAY_API_KEY=

# Optional. Any model id from https://vercel.com/ai-gateway/models (default: anthropic/claude-haiku-5.5).
QUOTATION_MODEL=

# Optional. Set to "offline" to force rule-based matching even when a key is present.
QUOTATION_AI_MODE=
